# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Answer layer + eval judge ---
# The code speaks the Anthropic Messages protocol. Any endpoint that accepts it works —
# only the model name changes, never the SDK calls.
#
# 1. Local proxy fronting a Codex/Claude/Gemini subscription (CLIProxyAPI etc.):
#    point ANTHROPIC_BASE_URL at it. The proxy holds the credentials.
# 2. Anthropic directly: real key here, leave ANTHROPIC_BASE_URL empty, set the
#    model names to a Claude model id.
#
# Caveat when proxying — output_config.format.json_schema may be silently ignored
# (no error, free text comes back). The judge does not rely on it. See decisions.md D12.
ANTHROPIC_API_KEY=proxy
ANTHROPIC_BASE_URL=http://127.0.0.1:8317

# Must match what the endpoint actually serves.
ANSWER_MODEL=gpt-5.6-sol
JUDGE_MODEL=gpt-5.6-sol

# --- Embeddings + reranking: LOCAL, no API key, no network at query time ---
# Models download once into .models/ (gitignored), then run on this machine.
# Documents never leave the box — see docs/decisions.md D11.
EMBEDDING_MODEL=Xenova/bge-base-en-v1.5
EMBEDDING_DIM=768
RERANK_MODEL=Xenova/bge-reranker-base

# BGE needs an instruction prefix on the QUERY side only (not on documents).
# Dropping it measurably hurts short-question → long-passage retrieval.
QUERY_PREFIX=Represent this sentence for searching relevant passages:

# --- Postgres + pgvector ---
# WSL2 forwards localhost, so a server inside WSL is reachable at localhost:5432.
DATABASE_URL=postgresql://citefirst:citefirst@localhost:5432/citefirst

# --- tunables (record the values you shipped in docs/portfolio.md) ---
CHUNK_TOKENS=512
CHUNK_OVERLAP=64
RETRIEVE_TOP_K=20
RERANK_TOP_N=5

# Reranking on/off — the eval harness flips this to produce the before/after table.
RERANK_ENABLED=true

# Hybrid retrieval (Postgres full-text search fused with vector search via RRF).
#
# Default off, and that default came from measurement — but read which measurement.
# At 26 questions, BEFORE query rewriting existed, it LOWERED recall on the confusable
# set (0.895 -> 0.842): if the question never says VACUUM, keyword search cannot find that
# document either, and it displaced good vector candidates during fusion.
#
# At 46 questions WITH rewriting on, that cause is gone — the rewritten queries do contain
# the identifier — and hybrid is no longer harmful: recall@5 0.978 either way, MRR@10
# 0.834 -> 0.849. It is still off by default because a small MRR gain does not pay for a
# second index and a second search per query, not because it is known to hurt.
# The identifier-phrased comparison has not been re-run at 46 questions. See docs/portfolio.md.
HYBRID_ENABLED=false

# Query rewriting: an LLM turns the user's question into 2-3 search queries that use the
# vocabulary the documentation itself uses ("sorts spilling to disk" -> "work_mem"), then
# every query is searched and the ranks are fused. The original query is always kept.
#
# This is the technique that closed the vocabulary gap hybrid search could not: on
# symptom-phrased questions (46 questions, reranking on) recall@5 went 0.826 -> 0.978 and
# MRR@10 0.544 -> 0.834. It costs one extra LLM call per question — measured 4,066ms mean
# and 12,648ms worst case, ~630 input tokens, 0 failures in 46.
#
# Be honest about what it measures: the rewriting model already knows PostgreSQL, so part
# of that gain is its prior knowledge, not better retrieval. On a corpus the model has
# never seen (your internal documents) expect a smaller gain. See docs/portfolio.md.
REWRITE_ENABLED=true
# Defaults to ANSWER_MODEL. Split out so you can try a cheaper model for this step.
# REWRITE_MODEL=gpt-5.6-sol
REWRITE_MAX_QUERIES=3

# Which query the cross-encoder reranker scores against: original | expanded
#
# This one matters more than it looks. With rewriting on and the reranker still scoring
# against the ORIGINAL wording, recall@5 dropped 0.978 -> 0.913 (46 questions): the reranker
# is a small model that cannot bridge the vocabulary gap either, so it pushed the
# freshly-found answers back down. Feeding it the expanded query fixed that and raised MRR
# further (0.619 -> 0.834).
RERANK_QUERY=expanded

# Rewrites are cached to this file and the file is committed, so the published numbers
# reproduce. Rewriting is not deterministic — two runs of the identical configuration
# differed by 0.038 recall@5 (0.962 vs 1.000, at 26 questions) before the cache existed.
# With the cache, three separate runs of the shipped configuration matched to four decimals.
# Delete the file to re-generate, and re-publish the table if you do.
# Set to empty to disable the disk cache.
# REWRITE_CACHE_PATH=eval/rewrite-cache.json

# Reasoning effort: low | medium | high | xhigh | max
# RAG answering is a narrow task — start low, raise only if eval says to.
ANSWER_EFFORT=low
