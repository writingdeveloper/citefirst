!corpus/.gitkeep

# db
pgdata/
*.sqlite
*.db

# eval — results ARE committed (portfolio evidence); scratch is not
eval/results/scratch/

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# logs
*.log
npm-debug.log*

# 로컬 모델 가중치 — 커밋하지 않는다 (수백 MB)
.models/
